{
  "manifest_version": 3,
  "name": "TradeVision AI Terminal",
  "version": "1.4.8",
  "description": "Multi-modal chart analyzer.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "offscreen",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "https://openai.com/*",
    "https://groq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": [
        "constants.js",
        "storage-utils.js",
        "content-script.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TradeVision AI"
  }
}
